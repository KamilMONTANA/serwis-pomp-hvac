---
import Icon from './Icon.astro';
import Logo from '../assets/images/logo.svg';
---

<header class="fixed top-0 left-0 right-0 z-50 bg-white/95 backdrop-blur-md border-b border-slate-200/90 shadow-sm">
  <div class="h-20 max-w-7xl mx-auto px-4 sm:px-6 lg:px-12 flex items-center justify-between gap-4">
    <div class="flex items-center gap-3 shrink-0">
      <a href="/" class="flex items-center gap-3 group" aria-label="TermoPro - Strona główna">
        <Logo 
          class="h-9 sm:h-10 w-auto object-contain transition-transform group-hover:scale-105" 
          width="160"
          height="40"
          aria-hidden="true"
        />
      </a>
    </div>

    <!-- Nawigacja Desktop -->
    <nav class="hidden lg:flex items-center text-base font-medium gap-2" aria-label="Główna nawigacja">
      <a class="px-4 py-2 rounded-xl text-slate-700 hover:text-navy-brand hover:bg-slate-100 transition-colors" href="#pakiety">Pakiety</a>
      <a class="px-4 py-2 rounded-xl text-slate-700 hover:text-navy-brand hover:bg-slate-100 transition-colors" href="#realizacje">Realizacje</a>
      <a class="px-4 py-2 rounded-xl text-slate-700 hover:text-navy-brand hover:bg-slate-100 transition-colors" href="#kalkulator">Kalkulator</a>
      <a class="px-4 py-2 rounded-xl text-slate-700 hover:text-navy-brand hover:bg-slate-100 transition-colors" href="#opinie">Opinie</a>
      <a class="px-4 py-2 rounded-xl text-slate-700 hover:text-navy-brand hover:bg-slate-100 transition-colors" href="#faq">FAQ</a>
    </nav>

    <div class="flex items-center gap-2 sm:gap-4 shrink-0">
      <!-- Dyżur 24/7 z numerem telefonu -->
      <a 
        class="hidden sm:flex items-center gap-2 text-base text-navy-brand font-bold px-3 py-2 rounded-xl hover:bg-slate-100 transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-navy-brand" 
        href="tel:+48221234567"
        aria-label="Zadzwoń pod całodobowy numer +48 22 123 45 67"
      >
        <Icon name="call" class="w-5 h-5 text-green-brand" />
        <span class="hidden md:inline">+48 22 123 45 67</span>
        <span class="md:hidden">24/7</span>
      </a>

      <a 
        class="flex items-center gap-2 px-3.5 sm:px-5 py-2.5 rounded-xl bg-amber-brand hover:bg-amber-brand-hover text-white font-bold text-sm sm:text-base transition-all duration-150 shadow-md shadow-orange-500/20 active:scale-[0.98] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:ring-navy-brand whitespace-nowrap shrink-0" 
        href="#zgloszenie"
      >
        <svg class="w-4 h-4 sm:w-5 sm:h-5 shrink-0 text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z" />
          <line x1="12" y1="9" x2="12" y2="13" />
          <line x1="12" y1="17" x2="12.01" y2="17" />
        </svg>
        <span>Zgłoś awarię</span>
      </a>

      <!-- Przycisk menu mobilnego -->
      <button 
        type="button"
        id="mobileMenuBtn"
        class="lg:hidden w-11 h-11 rounded-xl flex items-center justify-center text-slate-700 hover:text-navy-brand hover:bg-slate-100 transition-all duration-150 active:scale-[0.96] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-navy-brand"
        aria-expanded="false"
        aria-controls="mobileMenuNav"
        aria-label="Otwórz menu nawigacji"
      >
        <svg id="hamburgerIcon" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
        <svg id="closeIcon" class="w-6 h-6 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Panel nawigacji mobilnej -->
  <div 
    id="mobileMenuNav" 
    class="hidden lg:hidden border-t border-slate-200/90 bg-white/98 backdrop-blur-md px-6 py-5 shadow-xl transition-all"
  >
    <nav class="flex flex-col gap-1 text-base font-semibold" aria-label="Nawigacja mobilna">
      <a class="mobile-nav-link px-4 py-3 rounded-xl text-slate-800 hover:text-navy-brand hover:bg-slate-100 transition-colors" href="#pakiety">Pakiety serwisowe</a>
      <a class="mobile-nav-link px-4 py-3 rounded-xl text-slate-800 hover:text-navy-brand hover:bg-slate-100 transition-colors" href="#realizacje">Realizacje i montaże</a>
      <a class="mobile-nav-link px-4 py-3 rounded-xl text-slate-800 hover:text-navy-brand hover:bg-slate-100 transition-colors" href="#kalkulator">Kalkulator oszczędności</a>
      <a class="mobile-nav-link px-4 py-3 rounded-xl text-slate-800 hover:text-navy-brand hover:bg-slate-100 transition-colors" href="#opinie">Opinie klientów</a>
      <a class="mobile-nav-link px-4 py-3 rounded-xl text-slate-800 hover:text-navy-brand hover:bg-slate-100 transition-colors" href="#faq">Częste pytania (FAQ)</a>
    </nav>
    <div class="mt-4 pt-4 border-t border-slate-100 flex flex-col gap-3">
      <a 
        class="mobile-nav-link flex items-center justify-center gap-2 py-3.5 px-4 rounded-xl bg-emerald-50 text-green-brand font-bold text-base border border-emerald-200/80 hover:bg-emerald-100 transition-colors" 
        href="tel:+48221234567"
      >
        <Icon name="call" class="w-5 h-5 text-green-brand" />
        <span>Zadzwoń: +48 22 123 45 67 (24/7)</span>
      </a>
    </div>
  </div>
</header>

<script>
  const menuBtn = document.getElementById('mobileMenuBtn');
  const mobileNav = document.getElementById('mobileMenuNav');
  const hamburgerIcon = document.getElementById('hamburgerIcon');
  const closeIcon = document.getElementById('closeIcon');
  const mobileLinks = document.querySelectorAll('.mobile-nav-link');

  function toggleMenu(open?: boolean) {
    const shouldOpen = open !== undefined ? open : mobileNav?.classList.contains('hidden');
    if (shouldOpen) {
      mobileNav?.classList.remove('hidden');
      mobileNav?.classList.add('animate-slide-down');
      menuBtn?.setAttribute('aria-expanded', 'true');
      menuBtn?.setAttribute('aria-label', 'Zamknij menu nawigacji');
      hamburgerIcon?.classList.add('hidden');
      closeIcon?.classList.remove('hidden');
    } else {
      mobileNav?.classList.add('hidden');
      mobileNav?.classList.remove('animate-slide-down');
      menuBtn?.setAttribute('aria-expanded', 'false');
      menuBtn?.setAttribute('aria-label', 'Otwórz menu nawigacji');
      hamburgerIcon?.classList.remove('hidden');
      closeIcon?.classList.add('hidden');
    }
  }

  menuBtn?.addEventListener('click', () => toggleMenu());

  mobileLinks.forEach((link) => {
    link.addEventListener('click', () => toggleMenu(false));
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && !mobileNav?.classList.contains('hidden')) {
      toggleMenu(false);
      menuBtn?.focus();
    }
  });

  document.addEventListener('click', (e) => {
    const target = e.target as HTMLElement | null;
    if (
      !mobileNav?.classList.contains('hidden') && 
      !menuBtn?.contains(target) && 
      !mobileNav?.contains(target)
    ) {
      toggleMenu(false);
    }
  });
</script>
