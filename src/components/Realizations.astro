---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import heroHeatPumpImg from '../assets/images/hero-heat-pump.jpg';
import boilerRoomImg from '../assets/images/boiler-room.jpg';
import diagnosticsFgasImg from '../assets/images/diagnostics-fgas.jpg';
import quietInstallationImg from '../assets/images/quiet-installation.jpg';

const realizations = [
  {
    title: "Montaż jednostki zewnętrznej powietrznej pompy ciepła",
    desc: "Precyzyjny montaż z orurowaniem w osłonie UV i wibroizolacją fundamentową na dedykowanym cokole betonowym.",
    badge: "Montaż na zewnątrz",
    badgeIcon: "check" as const,
    detailBadge: "Wykonano zgodnie z WT",
    subtext: "Dom jednorodzinny 180 m²",
    imgSrc: heroHeatPumpImg
  },
  {
    title: "Kotłownia i hydraulika wewnętrzna",
    desc: "Kompleksowa stacja hydrauliczna z buforem, grupami pompowymi, odmulaczem magnetycznym i naczyniami wzbiorczymi.",
    badge: "Kotłownia i hydraulika",
    badgeIcon: "check" as const,
    detailBadge: "Sprawdzona próba ciśnieniowa",
    subtext: "Instalacja hybrydowa C.O. + C.W.U.",
    imgSrc: boilerRoomImg
  },
  {
    title: "Diagnostyka chłodnicza i serwis F-Gaz",
    desc: "Pomiar dochłodzenia, przegrzania oraz cyfrowa telemetria inwertera przy użyciu precyzyjnych opraw manometrycznych.",
    badge: "Diagnostyka chłodnicza",
    badgeIcon: "build" as const,
    detailBadge: "Certyfikat UDT kat. 1",
    subtext: "Wpis do CRO w 24h",
    imgSrc: diagnosticsFgasImg
  },
  {
    title: "Wyciszona instalacja przydomowa",
    desc: "Dedykowane stopy antywibracyjne i optymalizacja przepływu powietrza gwarantujące bezgłośną pracę pompy w nocy.",
    badge: "Wyciszenie & akustyka",
    badgeIcon: "check" as const,
    detailBadge: "Pomiar hałasu poniżej 35 dB(A)",
    subtext: "Nowoczesna zabudowa willowa",
    imgSrc: quietInstallationImg
  }
];
---

<section class="py-24 lg:py-32 px-6 lg:px-12 bg-slate-50 border-t border-slate-200/80" id="realizacje">
  <div class="max-w-7xl mx-auto flex flex-col gap-16">
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-6">
      <div class="max-w-2xl flex flex-col gap-3">
        <h2 class="font-headline text-3xl sm:text-4xl font-extrabold text-navy-brand tracking-tight">
          Nasze realizacje i prace serwisowe
        </h2>
        <p class="text-lg text-slate-600 leading-relaxed">
          Zobacz standard inżynieryjny montaży i przeglądów pomp ciepła realizowanych przez certyfikowany zespół TermoPro.
        </p>
      </div>
      <a 
        class="inline-flex items-center gap-2 px-6 py-3 rounded-xl bg-white border border-slate-200 text-navy-brand font-bold text-base hover:bg-slate-100 transition-colors shadow-sm" 
        href="#zgloszenie"
      >
        <span>Zgłoś swoją instalację</span>
        <Icon name="arrow_forward" class="w-5 h-5" />
      </a>
    </div>

    <!-- Siatka galerii -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      {realizations.map((item) => (
        <div class="group rounded-3xl overflow-hidden bg-white border border-slate-200 shadow-sm hover:shadow-md transition-all flex flex-col">
          <div class="relative overflow-hidden h-72 sm:h-80 bg-slate-100">
            <Image 
              src={item.imgSrc} 
              alt={item.title} 
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" 
              loading="lazy"
              decoding="async"
              width={600}
              height={350}
              format="webp"
            />
            <div class="absolute top-4 left-4 px-3.5 py-1.5 rounded-full bg-slate-900/80 backdrop-blur-sm text-white text-xs font-semibold flex items-center gap-1.5">
              <Icon name={item.badgeIcon} class="w-3.5 h-3.5 text-green-brand" />
              <span>{item.badge}</span>
            </div>
          </div>
          <div class="p-6 sm:p-8 flex flex-col gap-2 flex-1 justify-between">
            <div>
              <h3 class="font-headline text-xl font-bold text-navy-brand">{item.title}</h3>
              <p class="text-base text-slate-600 mt-2 leading-relaxed">{item.desc}</p>
            </div>
            <div class="pt-4 border-t border-slate-100 flex items-center justify-between text-sm text-slate-500 font-medium">
              <span class="flex items-center gap-1.5 text-green-brand font-semibold">
                <Icon name="verified" class="w-4 h-4 shrink-0" />
                <span>{item.detailBadge}</span>
              </span>
              <span>{item.subtext}</span>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
