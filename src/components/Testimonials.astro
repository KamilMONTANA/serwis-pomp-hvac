---
import Icon from './Icon.astro';

const testimonials = [
  {
    quote: "„W trakcie silnych mrozów pompa nagle zgłosiła błąd przepływu 7H i ogrzewanie stanęło. Serwisant TermoPro przyjechał w niespełna 3 godziny, wyczyścił filtr magnetyczny i skalibrował zawór. Pełen profesjonalizm.”",
    author: "Marek Kowalczyk",
    location: "Warszawa • Daikin Altherma"
  },
  {
    quote: "„Po instalacji przez inną firmę pompa zużywała bardzo duże ilości energii. Inżynier z TermoPro skorygował histerezę, krzywą grzewczą i wyregulował przepływy pętli. Zużycie prądu wyraźnie spadło.”",
    author: "Katarzyna Nowak",
    location: "Piaseczno • Panasonic Aquarea"
  },
  {
    quote: "„Zleciłem kompleksowy montaż nowej gruntowej pompy NIBE. Ekipa wykonała pracę czysto, sprawnie i zgodnie ze sztuką. Protokół i dokumenty pod dofinansowanie przygotowane od razu bez zbędnych poprawek.”",
    author: "Paweł Wieczorek",
    location: "Wołomin • NIBE F1245"
  }
];
---

<section class="py-24 lg:py-32 px-6 lg:px-12 bg-slate-50 border-t border-slate-200/70" id="opinie">
  <div class="max-w-7xl mx-auto flex flex-col gap-16">
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-6">
      <div class="max-w-2xl flex flex-col gap-3">
        <h2 class="font-headline text-3xl sm:text-4xl font-extrabold text-navy-brand tracking-tight">
          Opinie właścicieli instalacji
        </h2>
        <p class="text-lg text-slate-600 leading-relaxed">
          Autentyczne relacje z wykonanych serwisów okresowych oraz pilnych interwencji zimowych.
        </p>
      </div>

      <div class="flex items-center gap-3 bg-white px-5 py-3 rounded-2xl border border-slate-200 shadow-sm">
        <div class="flex text-amber-500 gap-0.5" role="img" aria-label="Ocena 5 na 5 gwiazdek">
          <Icon name="star" class="w-5 h-5 text-amber-500" />
          <Icon name="star" class="w-5 h-5 text-amber-500" />
          <Icon name="star" class="w-5 h-5 text-amber-500" />
          <Icon name="star" class="w-5 h-5 text-amber-500" />
          <Icon name="star" class="w-5 h-5 text-amber-500" />
        </div>
        <span class="font-headline text-2xl font-extrabold text-navy-brand">4.9 / 5.0</span>
        <span class="text-base text-slate-500">(340+ opinii)</span>
      </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      {testimonials.map((item) => (
        <div class="p-8 sm:p-10 rounded-3xl bg-white border border-slate-200/90 shadow-sm flex flex-col justify-between">
          <p class="text-base sm:text-lg text-slate-700 leading-relaxed mb-8">
            {item.quote}
          </p>
          <div class="border-t border-slate-100 pt-5">
            <p class="text-base font-bold text-navy-brand">{item.author}</p>
            <p class="text-base text-slate-500">{item.location}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
