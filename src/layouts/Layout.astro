---
interface Props {
  title?: string;
  description?: string;
  preloadImage?: string;
}

const {
  title = "TermoPro - Autoryzowany Serwis Pomp Ciepła i HVAC",
  description = "Profesjonalny serwis, przeglądy F-Gaz i montaż pomp ciepła. Czas dojazdu pogotowia awaryjnego do 4h, certyfikowani inżynierowie UDT, wpisy do rejestru CRO.",
  preloadImage
} = Astro.props;

import '../styles/global.css';
---

<!DOCTYPE html>
<html lang="pl" class="h-full scroll-smooth">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
  <meta name="description" content={description} />
  <meta name="theme-color" content="#0a2540" />
  <title>{title}</title>

  <!-- Favicon -->
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

  <!-- Preload kluczowego obrazu LCP (Hero) -->
  {preloadImage && (
    <link rel="preload" as="image" href={preloadImage} fetchpriority="high" />
  )}

</head>
<body class="min-h-full bg-slate-50/50 text-slate-900 font-body antialiased flex flex-col selection:bg-orange-500 selection:text-white">
  <!-- Skip Link dla dostępności (WCAG 2.2 AA) -->
  <a 
    href="#zgloszenie" 
    class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-50 focus:px-4 focus:py-2 focus:bg-navy-brand focus:text-white focus:rounded-xl focus:shadow-lg focus:ring-2 focus:ring-orange-500"
  >
    Przejdź do formularza zgłoszenia
  </a>

  <slot />
</body>
</html>
